# .gitignore — Python

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environment variables and secrets
.env
*.key
secret.key

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/

# Testing / coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
